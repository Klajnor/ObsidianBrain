# Скопируйте в .env и заполните. .env в .gitignore – не коммитить.
# Путь к хранилищу Obsidian (папка с заметками). Обязательный параметр.
# Можно несколько хранилищ через «;». Каждый путь – абсолютный или относительно
# каталога с кодом. Путь заметки в БД начинается с имени каталога хранилища.
# Примеры:
#   VAULT_PATH=d:\Obsidian
#   VAULT_PATH=../Obsidian Git;../Obsidian Personal
VAULT_PATH=../Obsidian Git

# Нужен любой OpenAI-совместимый сервер (OpenAI, OpenRouter, LiteLLM, Ollama, LM Studio, vLLM ...).

# Базовый URL API (с /v1). Примеры:
#   OpenAI:     https://api.openai.com/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   Ollama:     http://localhost:11434/v1
#   LM Studio:  http://localhost:1234/v1
LLM_BASE_URL=https://api.openai.com/v1

# Ключ API. Для локальных серверов без авторизации можно оставить пустым.
LLM_API_KEY=

# Имя модели, как его ожидает сервер (например gpt-4o-mini, qwen2.5:14b).
LLM_MODEL=gpt-4o-mini

# --- необязательное ---
# Макс. токенов в ответе (карточка заметки). По умолчанию 1500.
# LLM_MAX_TOKENS=1500

# Таймаут запроса, секунд. Для медленных локальных моделей увеличьте. По умолчанию 120.
# LLM_TIMEOUT=120

# Режим response_format=json_object. Поставьте 0, если сервер его не поддерживает
# (JSON тогда берётся из текста ответа). По умолчанию 1.
# LLM_JSON_MODE=1

# Порог длины заметки (символов), после которого она суммаризируется по разделам.
# Для моделей с малым контекстом уменьшите. По умолчанию 60000.
# LLM_MAX_INPUT_CHARS=60000
