# Скопируйте в .env и заполните. .env в .gitignore – не коммитить.
# Путь к хранилищу Obsidian (папка с заметками). Обязательный параметр.
# Можно несколько хранилищ через «;». Каждый путь – абсолютный или относительно
# каталога с кодом. Путь заметки в БД начинается с имени каталога хранилища.
# Примеры:
#   VAULT_PATH=d:\Obsidian
#   VAULT_PATH=../Obsidian Git;../Obsidian Personal
VAULT_PATH=../Obsidian Git

# Нужен любой OpenAI-совместимый сервер (OpenAI, OpenRouter, LiteLLM, Ollama, LM Studio, vLLM ...).

# Базовый URL API (с /v1). Примеры:
#   OpenAI:     https://api.openai.com/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   Ollama:     http://localhost:11434/v1
#   LM Studio:  http://localhost:1234/v1
# Вне localhost/127.0.0.1/::1 используйте HTTPS: по HTTP ключ и заметки идут
# открытым текстом. Для LAN-сервера по HTTP осознанно задайте LLM_ALLOW_HTTP=1.
# LLM_ALLOW_HTTP=1
LLM_BASE_URL=https://api.openai.com/v1

# Ключ API. Для локальных серверов без авторизации можно оставить пустым.
LLM_API_KEY=

# Имя модели, как его ожидает сервер (например gpt-4o-mini, qwen2.5:14b).
LLM_MODEL=gpt-4o-mini

# --- необязательное ---
# Макс. токенов в ответе (карточка заметки). По умолчанию 1500.
# LLM_MAX_TOKENS=1500

# Таймаут запроса, секунд. Для медленных локальных моделей увеличьте. По умолчанию 120.
# LLM_TIMEOUT=120

# Режим response_format=json_object. Поставьте 0, если сервер его не поддерживает
# (JSON тогда берётся из текста ответа). По умолчанию 1.
# LLM_JSON_MODE=1

# Порог длины заметки (символов), после которого она суммаризируется по разделам.
# Для моделей с малым контекстом уменьшите. По умолчанию 60000.
# LLM_MAX_INPUT_CHARS=60000

# Потолок числа фрагментов одной заметки в map-reduce (LLM-вызовов на заметку).
# Лишние фрагменты не отправляются. По умолчанию 60.
# LLM_MAX_CHUNKS=60

# Заметки больше N байт не читаются и не индексируются (прежний индекс сохраняется).
# По умолчанию 5 МБ.
# LLM_MAX_NOTE_BYTES=5242880

# --- журнал ошибок ---
# Файл для посмертной диагностики: предупреждения и ошибки sync.py / mcp_server.py.
# «auto» (по умолчанию) — errors.log рядом с базой (data/errors.log); «off» —
# только stderr (journald при systemd); путь (лучше абсолютный) переопределяет.
# LOG_FILE=auto
# Минимальный уровень записей в журнале: DEBUG, INFO, WARNING, ERROR или CRITICAL.
# LOG_FILE_LEVEL=WARNING

# --- связи заметок ---
# Связность: заметки с общими тегами сравниваются ИИ по готовым саммари.
# Связи кэшируются в SQLite; при изменении заметки её пары пересчитываются.
# По умолчанию 1; 0 — только теги, без LLM-сравнений.
# BRAIN_LINKS_ENABLED=1
# Минимальная оценка (0..1), которую MCP отдаёт как связанную заметку.
# BRAIN_LINK_MIN_SCORE=0.65
# Потолок LLM-сравнений за один прогон sync.py; 0 — не сравнивать.
# BRAIN_LINK_MAX_PAIRS=100
# Потолок сильных связей на заметку и потолок заметок у одного общего тега.
# BRAIN_LINK_MAX_PER_NOTE=12
# BRAIN_LINK_MAX_TAG_FANOUT=40
# Fallback по keywords/entities для заметок без теговых пар: минимум общих
# терминов и потолок заметок у одного термина. 0 — отключить fallback.
# BRAIN_LINK_MIN_SHARED_TERMS=2
# BRAIN_LINK_MAX_TERM_FANOUT=30
# Макс. токенов в JSON-ответе сравнения пары. Для reasoning-моделей малое
# значение обрезает ответ; по умолчанию 1200.
# LLM_LINK_MAX_TOKENS=1200
# Повторы при пустом/битом ответе пары (0 — без повторов). При повторе лимит
# токенов удваивается до LLM_LINK_MAX_TOKENS_CAP. По умолчанию 1.
# LLM_LINK_RETRIES=1
# LLM_LINK_MAX_TOKENS_CAP=4000
# После N ошибок ответа подряд пара откладывается, чтобы не занимать очередь
# каждый прогон; 0 — пробовать всегда. Сброс — python sync.py --rebuild-links.
# BRAIN_LINK_MAX_ATTEMPTS=3

# Создание новых заметок через MCP (только Telegram/, без перезаписи).
# Для бота лучше передать переменную в env сервера в .mcp.json.
# После создания выполняются commit + push только этого файла. Нужны Git-клон
# первого хранилища, upstream, user.name/user.email и доступ к remote на запись.
BRAIN_WRITE_ENABLED=false
