# Пример systemd-юнита: постоянная индексация хранилищ (python sync.py --watch).
# Здесь и ниже путь к репозиторию — /opt/brain, пользователь — brain; замени на свои.
#
# Установка:
#   sudo ./install-systemd.sh sync
#   sudo systemctl enable --now brain-sync
# Логи: journalctl -u brain-sync -f
#
# Внимание:
# - MCP-сервер (mcp_server.py) под systemd не запускают: он работает по stdio,
#   его стартует MCP-клиент по .mcp.json.
# - Альтернатива без демона: пара brain-pull.timer / brain-pull.service — раз в 5 минут
#   git pull хранилища и разовый sync.py (подходит и для хранилищ, доступных по NFS/SMB).

[Unit]
Description=Brain: инкрементальная дистилляция Obsidian-хранилищ в SQLite (watch)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Пользователю нужен доступ на чтение к хранилищам (VAULT_PATH) и на запись в data/;
# .env с LLM_API_KEY — chmod 600, владелец этот пользователь.
# UMask ниже создаёт data/ и brain.db (включая -wal/-shm) с правами 700/600.
# Для уже существующих файлов один раз выполните: chmod 700 data && chmod 600 .env data/brain.db*
User=brain
Group=brain
# WorkingDirectory и EnvironmentFile не нужны: .env и относительные VAULT_PATH
# код читает сам, от каталога со скриптом (common.load_env, BRAIN_DIR).
# Используем то же виртуальное окружение, что и brain-pull.service.
# Установка зависимостей: /opt/brain/.venv/bin/python -m pip install -r /opt/brain/requirements.txt
ExecStart=/opt/brain/.venv/bin/python /opt/brain/sync.py --watch
# SIGINT, а не SIGTERM: watch завершается чисто по KeyboardInterrupt (obs.stop())
KillSignal=SIGINT
Restart=on-failure
RestartSec=30
# Hardening: запись нужна только в data/, остальное – чтение.
# Если хранилище или репозиторий лежат в /home – убери ProtectHome.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/brain/data
ProtectHome=true
PrivateTmp=true
# В БД лежит полный текст заметок, а в .env — ключ API: не даём читать их другим.
UMask=0077
# Дополнительное ограничение поверхности атаки: процессу не нужны устройства,
# модули ядра, namespaces, realtime и capabilities.
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
