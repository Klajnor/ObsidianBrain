# Пример: разовый прогон «git pull хранилища + sync.py», запускается таймером brain-pull.timer.
# Это альтернатива демону brain-sync.service (--watch): выбрать одно из двух.
# Плейсхолдеры: /opt/brain — этот репозиторий, /srv/obsidian-vault — клон хранилища, brain — пользователь.
#
# Подготовка (один раз):
#   sudo -u brain git clone <URL-хранилища> /srv/obsidian-vault
#   Для приватного репозитория дай пользователю brain доступ: SSH deploy key
#   или credential helper с PAT (obsidian-git на десктопе сам коммитит и пушит).
#   VAULT_PATH в /opt/brain/.env должен указывать на /srv/obsidian-vault —
#   абсолютным путём или относительно каталога репозитория.
# Установка:
#   sudo cp brain-pull.service brain-pull.timer /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now brain-pull.timer
# Логи: journalctl -u brain-pull.service -f
# (Секция [Install] здесь намеренно не нужна: включается только таймер.)

[Unit]
Description=Brain: git pull хранилища Obsidian и переиндексация
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Пользователь должен иметь право писать в клон хранилища (git pull) и в data/
# этого репозитория; .env (LLM_API_KEY) — chmod 600, владелец brain.
# UMask ниже создаёт data/ и brain.db (включая -wal/-shm) с правами 700/600.
# Для уже существующих файлов один раз выполните: chmod 700 data && chmod 600 .env data/brain.db*
User=brain
Group=brain
# Несколько ExecStart у oneshot выполняются по порядку; сбой прерывает цепочку
# (нет сети -> pull не удался -> sync пропущен; таймер повторит через 5 минут).
# --ff-only: сервер — только зеркало, локальных коммитов в хранилище быть не должно.
WorkingDirectory=/opt/brain
# Не зависать на запросе логина/пароля в неинтерактивном юните.
Environment=GIT_TERMINAL_PROMPT=0
ExecStart=/usr/bin/git -C /srv/obsidian pull --ff-only
ExecStart=/usr/bin/git -C /srv/obsidian-personal pull --ff-only
ExecStart=/opt/brain/.venv/bin/python /opt/brain/sync.py
# Первый полный прогон (пустая data/brain.db) может занять десятки минут;
# потолок нужен, чтобы зависший git/LLM не блокировал таймер навсегда.
TimeoutStartSec=2h
# Hardening: запись – только в клоны хранилищ и data/; домашний каталог – только чтение
# (оттуда git/ssh берут креды и ключи). Если пути лежат в /home – подстрой ProtectHome.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/brain/data /srv/obsidian-vault /srv/obsidian-personal
ProtectHome=read-only
PrivateTmp=true
# В БД лежит полный текст заметок, а в .env — ключ API: не даём читать их другим.
UMask=0077
# Дополнительное ограничение поверхности атаки: процессу не нужны устройства,
# модули ядра, namespaces, realtime и capabilities.
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
