# Пример таймера: раз в 5 минут запускать brain-pull.service
# (git pull хранилища Obsidian с GitHub + переиндексация через sync.py).
# Установка и подготовка — в комментарии в brain-pull.service.

[Unit]
Description=Brain: обновление хранилища и переиндексация раз в 5 минут

[Timer]
# По календарю: в :00, :05, :10 … (вариант: OnUnitActiveSec=5min — через 5 минут
# после окончания предыдущего прогона). Пока сервис активен, таймер не срабатывает —
# перекрытий нет.
OnCalendar=*:0/5
# Догнать пропущенные запуски после простоя или выключения
Persistent=true

[Install]
WantedBy=timers.target
